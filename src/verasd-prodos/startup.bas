10 TEXT: HOME
20 PRINT "VeraSD ProDOS SD Driver v1.03"
30 PRINT "by anomixer 2026"
40 PRINT
50 REM --- Detect VERA in Slot 2 first, then Slot 4 ---
60 S = 0
61 POKE 49669,1
62 IF PEEK(49669) = 1 THEN GOTO 64
63 GOTO 80
64 POKE 49669,0
65 IF PEEK(49669) = 0 THEN GOTO 67
66 GOTO 80
67 POKE 49664,0
68 POKE 49665,0
69 POKE 49666,0
70 POKE 49667,222
71 IF PEEK(49667) = 222 THEN GOTO 73
72 GOTO 80
73 POKE 49667,111
74 IF PEEK(49667) = 111 THEN S = 2
80 IF S = 2 THEN GOTO 110
81 POKE 50181,1
82 IF PEEK(50181) = 1 THEN GOTO 84
83 GOTO 100
84 POKE 50181,0
85 IF PEEK(50181) = 0 THEN GOTO 87
86 GOTO 100
87 POKE 50176,0
88 POKE 50177,0
89 POKE 50178,0
90 POKE 50179,222
91 IF PEEK(50179) = 222 THEN GOTO 93
92 GOTO 100
93 POKE 50179,111
94 IF PEEK(50179) = 111 THEN S = 4
100 IF S = 0 THEN PRINT "No VERA Card Detected on Slot 2 or 4!": END
110 PRINT "VERA Card Detected: SLOT";S
120 IF S = 2 THEN SU$ = "S2": GOTO 140
130 SU$ = "S4"
140 N = PEEK(48945): F = 0
145 IF N = 0 THEN GOTO 160
150 FOR I = 0 TO N - 1
155 IF INT(PEEK(48946 + I) / 16) = S THEN F = 1
157 NEXT I
158 IF F = 1 THEN GOTO 220
160 PRINT "Checking SD Card..."
165 POKE 8176,0
170 PRINT CHR$(4);"BRUN VERASD.BIN"
180 REM --- Installer writes $A5 to $1FF0 only after successful online ---
190 IF PEEK(8176) = 165 THEN GOTO 220
200 PRINT "No SD Card Detected": END
220 PRINT "SD Card Detected"
230 PRINT
240 PRINT "1. Load VERASD Driver & CATALOG SD Card"
250 PRINT "2. Load VERASD Driver & Run A2Desktop"
260 PRINT "3. Exit"
270 INPUT "SELECT (1-3)";C
280 IF C = 1 THEN PRINT CHR$(4);"CATALOG,";SU$: GOTO 230
290 IF C = 2 THEN PRINT CHR$(4);"-DESKTOP.SYSTEM,";SU$: GOTO 230
300 IF C = 3 THEN END
310 PRINT "Invalid selection": GOTO 270
