10 TEXT: SPEED=255
15 HOME
20 PRINT "VeraSDFormat - FAT32 Formatter for VERA SD/MMC"
30 PRINT "by anomixer https://github.com/anomixer"
40 PRINT "---------------------------------------"
45 PRINT
50 REM --- Detect VERA card: Slot 2 first, then Slot 4 (same as veratest) ---
60 S = 0
61 POKE 49669,1
62 IF PEEK(49669) = 1 THEN GOTO 64
63 GOTO 80
64 POKE 49669,0
65 IF PEEK(49669) = 0 THEN GOTO 67
66 GOTO 80
67 POKE 49664,0
68 POKE 49665,0
69 POKE 49666,0
70 POKE 49667,222
71 IF PEEK(49667) = 222 THEN GOTO 73
72 GOTO 80
73 POKE 49667,111
74 IF PEEK(49667) = 111 THEN S = 2
80 IF S = 2 THEN GOTO 120
81 POKE 50181,1
82 IF PEEK(50181) = 1 THEN GOTO 84
83 GOTO 100
84 POKE 50181,0
85 IF PEEK(50181) = 0 THEN GOTO 87
86 GOTO 100
87 POKE 50176,0
88 POKE 50177,0
89 POKE 50178,0
90 POKE 50179,222
91 IF PEEK(50179) = 222 THEN GOTO 93
92 GOTO 100
93 POKE 50179,111
94 IF PEEK(50179) = 111 THEN S = 4
100 IF S = 0 THEN GOTO 140
120 PRINT "Checking..."
125 PRINT CHR$(4);"BRUN VERASDFORMAT"
130 END
140 PRINT "No VERA Card Detected on Slot 2 or 4!"
150 END
